# ── AI (only Anthropic needed — single fast model, not 4-model consensus)
ANTHROPIC_API_KEY=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

# ── Market data (ideally a SEPARATE Twelve Data key from your long-term bot,
#    since both bots share the same 800 calls/day free-tier limit otherwise)
#email is mdawoodriaz@gmail.com for short term long term email is nasirhamad
