# ── v5 NEW: Finnhub (free, 60 calls/min, no card — https://finnhub.io)
#    Powers: earnings-blackout check, dynamic sector/correlation buckets
#    for DISCOVERED tickers, and fresh headlines for the daily reviewer.
#    Everything works without this key too — those three features just
#    silently no-op until you add it.

FINNHUB_API_KEY=d94l0k1r01qgvhqpioq0d94l0k1r01qgvhqpioqg

# ── v5.1 NEW: Financial Modeling Prep (free, 250 req/day —
#    https://financialmodelingprep.com). Use a SEPARATE key from your
#    long-term bot so the two don't share one 250/day quota. Powers:
#    analyst-upgrade discovery candidates. Optional — discovery just runs
#    without this source if unset.
FMP_API_KEY=ngRyiux937z2h1w3CWri3ICm4uQu1RCN

# ── v5.1 NEW: SEC EDGAR full-text search (free, NO key — just a
#    descriptive User-Agent with contact info, required by SEC's fair-
#    access policy). Powers: insider Form-4-buy discovery candidates.
SEC_EDGAR_USER_AGENT=etoro-v2-short-bot mdawoodriaz@example.com

# ── v5.1 NEW: FRED (free, instant key — https://fred.stlouisfed.org).
#    Powers: real VIX blended into the market-regime classifier. Optional
#    — regime falls back to the SPY-range-only proxy without this key.
FRED_API_KEY=30831d0c3cb55bf8484a5a1d15cf189f


# ── v5.3 NEW: Alpaca Basic market data plan (free, WebSocket streaming —
#    https://app.alpaca.markets/signup, use PAPER TRADING keys, no funding
#    needed just for data). Replaces the slow sequential Twelve Data
#    watchlist polling with near-instant streamed quotes. Optional —
#    without these keys the bot falls back to the original Twelve Data
#    sequential fetch exactly as before.
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=


# ── Telegram (a SECOND bot — create via @BotFather, separate from your
#    long-term bot so messages don't mix in one chat)
DT_TELEGRAM_BOT_TOKEN=8687021321:AAE1SL6jZQiTmLqzebXFMniO-o4g1qVJ6Ds
DT_TELEGRAM_CHAT_ID=8742665348




# ── Capital allocated to THIS bot specifically ─────────────────────
DT_CAPITAL=100

# ── Scan frequency (minutes) during market hours ───────────────────
DT_SCAN_INTERVAL_MINUTES=10

# ── Legacy position sizing & limits (kept as compatibility fallbacks;
#    v4+ risk-based sizing below is what actually runs) ─────────────
DT_MAX_POSITION_PCT=0.08
DT_MAX_OPEN_POSITIONS=3
MINIMUM_POSITION_DOLLARS=10

# ── Legacy risk fallbacks (used only when ATR data is unavailable) ─
DT_STOP_LOSS_PCT=0.02
DT_TAKE_PROFIT_PCT=0.03
DT_TAKE_PROFIT_RUNNER_PCT=0.05
DT_DAILY_LOSS_LIMIT_PCT=0.05

# ── Momentum scanner thresholds ─────────────────────────────────────
DT_MIN_VOLUME_RATIO=1.5
DT_GAP_THRESHOLD_PCT=2.0
DT_BREAKOUT_LOOKBACK_DAYS=5
DT_RSI_MOMENTUM_MIN=55
DT_RSI_OVEREXTENDED_MAX=78
DT_MAX_CANDIDATES=8

# ── End-of-day force-close (minutes before 16:00 ET close) ─────────
DT_FORCE_CLOSE_MINUTES_BEFORE_CLOSE=15

LOG_LEVEL=info

# ════════════════════════════════════════════════════════════════
#  v2 — filters, trailing exits, session rules
# ════════════════════════════════════════════════════════════════
DT_PARTIAL_EXIT_FRACTION=0.5
DT_TRAILING_STOP_PCT=0.025
DT_MAX_HOLD_MINUTES=90

# WAS -0.3 which aborted the ENTIRE scan on any mildly-red SPY day (the
# code default is now -1.0; see the note in config.js). -1.0 lets a strong
# individual stock trade even when the broad market is slightly down; the
# per-stock relative-strength filter still requires it to be LEADING SPY.
DT_SPY_MIN_CHANGE_PCT=-1.0
DT_REQUIRE_ABOVE_VWAP=true
DT_MAX_PER_SECTOR_BUCKET=2

# 24/5 TRADING — trade eToro's overnight-eligible US stocks (TSLA, NVDA,
# AAPL, META, AMD, …, which is most of this watchlist) around the clock,
# Sunday 8 PM ET → Friday 8 PM ET. Off = the bot only runs 4 AM–8 PM ET and
# sleeps overnight. ON = it scans, enters, and manages positions 24/5 like a
# manual trader. Turn this OFF if you'd rather trade only US regular/extended
# hours.
DT_TRADE_24_5=true

# 24/5 overnight holds: keep PROFITABLE day trades running overnight (Mon–Thu)
# instead of force-closing them at 15:45 ET — the 24/5 exit engine keeps
# guarding their stop/targets. Losers/flat still close at EOD; Friday still
# closes everything for the weekend. A DAY trade must be at least this % in
# profit at EOD to be held over (0 = any green position).
DT_HOLD_24_5_OVERNIGHT=true
DT_OVERNIGHT_HOLD_MIN_PROFIT_PCT=0

# Pre-market entries (only relevant when DT_TRADE_24_5=false): allow entries
# from 4:00 AM ET instead of waiting for 9:30.
DT_ALLOW_PREMARKET=true
DT_PREMARKET_START_HOUR_ET=4

DT_SKIP_LUNCH_CHOP=true
DT_LUNCH_START_HOUR_ET=11
DT_LUNCH_START_MIN_ET=30
DT_LUNCH_END_HOUR_ET=14
DT_LUNCH_END_MIN_ET=0
DT_SKIP_FIRST_MINUTES=5

# ════════════════════════════════════════════════════════════════
#  v3 — cooldown, relative strength, regime, slippage
# ════════════════════════════════════════════════════════════════
DT_TRADE_COOLDOWN_MINUTES=30
DT_MIN_RS_VS_SPY_PCT=0.5
DT_CHOP_RANGE_THRESHOLD_PCT=0.5
DT_CHOP_REGIME_SCORE_PENALTY=15
DT_SLIPPAGE_BUFFER_PCT=0.001

# ════════════════════════════════════════════════════════════════
#  v4 — risk-based sizing, DAY+SWING, discovery, API optimization
# ════════════════════════════════════════════════════════════════
DT_RISK_PCT_DAY=0.01
DT_RISK_PCT_SWING=0.015
DT_MAX_POSITION_PCT_DAY=0.35
DT_MAX_POSITION_PCT_SWING=0.3
DT_MAX_DAY_POSITIONS=3
DT_MAX_SWING_POSITIONS=2
DT_MIN_RRR=1.5

DT_DERISK_AFTER_LOSING_DAYS=2
DT_DERISK_MULTIPLIER=0.5
DT_CAPITAL_FLOOR_PCT=0.4

DT_DAY_ATR_STOP_MULT=0.5
DT_SWING_ATR_STOP_MULT=1.5
DT_DAY_STOP_MIN_PCT=0.01
DT_DAY_STOP_MAX_PCT=0.03
DT_SWING_STOP_MIN_PCT=0.03
DT_SWING_STOP_MAX_PCT=0.08
DT_SWING_MAX_HOLD_DAYS=10
DT_SWING_ENTRY_DAYS=1,2,3
DT_FRIDAY_CLOSE_ALL=true

DT_LOW_VOL_ATR_PCT=2.5
DT_HIGH_VOL_ATR_PCT=5.0
DT_HIGH_VOL_SIZE_MULT=0.7

DT_DISCOVERY_ENABLED=true
DT_DISCOVERY_MAX_CANDIDATES=6
DT_DISCOVERY_MIN_CHANGE_PCT=3.0
DT_DISCOVERY_MIN_PRICE=2
DT_DISCOVERY_MAX_PRICE=500
DT_DISCOVERY_MIN_REL_VOLUME=2.0
DT_DISCOVERY_FIRST_SIZE_MULT=0.5

DT_ENRICH_CACHE_MINUTES=25
DT_ENRICH_CACHE_MAX_MOVE_PCT=0.3
DT_ADAPTIVE_CHOP_SCAN_MINUTES=20
DT_VOL_SPIKE_SPY_PCT=1.0
DT_DAILY_ATR_CACHE_HOURS=20

# ════════════════════════════════════════════════════════════════
#  v5 NEW — drawdown breaker, earnings blackout, daily AI reviewer,
#  system alerts
# ════════════════════════════════════════════════════════════════

# Liquidity/spread floor — reject entries below this avg $/day volume.
# Only enforced when the figure is actually known (never blocks on unknown).
DT_MIN_AVG_DOLLAR_VOLUME=2000000

# Rolling drawdown circuit breaker: halts ALL new entries (exits still
# run) if effective capital falls this % below its recorded peak.
# Resume manually: delete data/halt.flag on the server.
DT_MAX_DRAWDOWN_FROM_PEAK_PCT=0.15

# Earnings blackout (needs FINNHUB_API_KEY; silently skipped without it)
DT_EARNINGS_BLACKOUT_ENABLED=true
DT_EARNINGS_BLACKOUT_SWING_DAYS=5
DT_EARNINGS_BLACKOUT_DAY_DAYS=1

# Daily AI position reviewer (Tier 2) — Mon-Thu, ~45 min before EOD close.
# EXTEND converts a DAY position to SWING; guardrails below are enforced
# in CODE, not trusted to the AI.
DT_REVIEWER_ENABLED=true
DT_REVIEWER_HOUR_ET=15
DT_REVIEWER_MINUTE_ET=0
DT_REVIEWER_EXTEND_NEEDS_PROFIT=true
DT_REVIEWER_MIN_CONF_EXTEND=7
DT_REVIEWER_TIGHTEN_FACTOR=0.5

# System alerts (Telegram) — throttle so a repeating failure doesn't spam
DT_ALERT_THROTTLE_MINUTES=30
# Consecutive discovery failures before it becomes a Telegram alert
# (discovery is fail-open by design, so without this it can go dark silently)
DT_DISCOVERY_FAIL_ALERT_AFTER=3

# Run one scan immediately on startup (set "false" to wait for the cron)
DT_RUN_ON_STARTUP=true